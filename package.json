{
  "name": "martebizuteria",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack e-commerce platform for M'Arte Jewellery. High-performance storefront & admin dashboard built with TanStack Start and React. Luxury UX via GSAP & Lenis. Styled with Tailwind & Shadcn UI. Powered by Cloudflare Workers, D1, R2, and KV. Internationalized with use-intl.",
  "keywords": [
    "M`Arte",
    "e-commerce",
    "jewellery"
  ],
  "homepage": "https://martebizuteria.pjborowiecki.workers.dev",
  "bugs": {
    "url": "https://github.com/pjborowiecki/martebizuteria.pl_tanstack_start/issues"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "author": {
    "name": "Piotr Borowiecki",
    "email": "hello@pjborowiecki.com",
    "url": "https://pjborowiecki.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pjborowiecki/martebizuteria.pl_tanstack_start.git"
  },
  "type": "module",
  "scripts": {
    "dev": "CLOUDFLARE_ENV=preview vp dev",
    "build": "tsc && CLOUDFLARE_ENV=preview vp build",
    "preview": "CLOUDFLARE_ENV=preview vp preview",
    "clean": "rm -rf dist .wrangler .tanstack coverage playwright-report test-results blob-report .bun-cache",
    "clean:deep": "bun run clean && rm -rf node_modules",
    "clean:hardcore": "bun run clean:deep && rm -rf bun.lock opensrc",
    "db:generate": "bun --env-file=.env.local vp exec drizzle-kit generate --config src/integrations/drizzle-orm/drizzle.config.ts",
    "db:migrate": "bun --env-file=.env.local vp exec drizzle-kit migrate --config src/integrations/drizzle-orm/drizzle.config.ts",
    "db:migrate:production": "bun --env-file=.env.production vp exec drizzle-kit migrate --config src/integrations/drizzle-orm/drizzle.config.ts",
    "db:push": "bun --env-file=.env.local vp exec drizzle-kit push --config src/integrations/drizzle-orm/drizzle.config.ts",
    "db:push:production": "bun --env-file=.env.production vp exec drizzle-kit push --config src/integrations/drizzle-orm/drizzle.config.ts",
    "db:pull": "bun --env-file=.env.local vp exec drizzle-kit pull --config src/integrations/drizzle-orm/drizzle.config.ts",
    "db:pull:production": "bun --env-file=.env.production vp exec drizzle-kit pull --config src/integrations/drizzle-orm/drizzle.config.ts",
    "db:studio": "bun --env-file=.env.local vp exec drizzle-kit studio --config src/integrations/drizzle-orm/drizzle.config.ts",
    "db:studio:production": "bun --env-file=.env.production vp exec drizzle-kit studio --config src/integrations/drizzle-orm/drizzle.config.ts",
    "db:admin": "vp exec wrangler d1 execute martebizuteria-preview",
    "db:admin:production": "vp exec wrangler d1 execute martebizuteria",
    "db:seed": "vp exec wrangler d1 execute martebizuteria-preview --remote --file=scripts/seed.sql",
    "db:seed:production": "vp exec wrangler d1 execute martebizuteria --remote --file=scripts/seed.sql",
    "check": "vp check --no-fmt --no-lint",
    "check:staged": "vp staged --no-fmt --no-lint",
    "lint": "vp lint",
    "format": "vp fmt",
    "prepare": "vp config",
    "test": "vp test",
    "test:watch": "vp test watch",
    "test:coverage": "vp test run --coverage",
    "postinstall": "bun run cf-typegen",
    "cf-typegen": "wrangler types src/types/worker-configuration.d.ts",
    "deploy:production": "CLOUDFLARE_ENV=production vp build && wrangler deploy --config dist/server/wrangler.json",
    "deploy:preview": "CLOUDFLARE_ENV=preview vp build && wrangler deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.4.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-router": "^1.170.4",
    "@tanstack/react-router-ssr-query": "^1.167.0",
    "@tanstack/react-start": "^1.168.6",
    "@unpic/react": "^1.0.2",
    "@wrksz/themes": "^0.9.2",
    "better-auth": "^1.6.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "embla-carousel-react": "^8.6.0",
    "gsap": "^3.15.0",
    "input-otp": "^1.4.2",
    "lenis": "^1.3.23",
    "lucide-react": "^1.16.0",
    "nuqs": "^2.8.9",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.6",
    "react-email": "^6.1.4",
    "react-hook-form": "^7.76.1",
    "react-resizable-panels": "^4.11.1",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "stripe": "^22.1.1",
    "unpic": "^4.2.2",
    "use-intl": "^4.12.0",
    "uuid": "^14.0.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.37.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query-devtools": "^5.100.11",
    "@types/node": "^25.9.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "drizzle-kit": "^0.31.10",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@^0.1.21",
    "vite-plus": "^0.1.21",
    "wrangler": "^4.92.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "packageManager": "bun@1.3.13"
}
