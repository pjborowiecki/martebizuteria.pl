# =============================================================================
# Copy to `.env.development`, `.env.preview`, and `.env.production` (all gitignored).
# Set each mode's app URL and credentials. `dev` uses development; `build:preview`
# and `build:production` load their matching files. Avoid shared `.env.local` overrides.
# `.env.test` contains dummy values for local tests and CI builds.
#
# Vite exposes only VITE_* values to the browser. Wrangler loads the matching
# environment file for local Worker secrets. Deploy scripts upload only secrets
# declared in wrangler.jsonc; Cloudflare management credentials remain local.
# =============================================================================

# --- Public (browser-safe; VITE_ prefix required) ---
VITE_R2_URL="https://pub-a9ce13f98e72423eb72107a4e696f2e0.r2.dev"
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_change_me"

# --- Private (not read by Vite unless you add a VITE_ name) ---
AUTH_SECRET=
AUTH_GOOGLE_CLIENT_ID="change_me"
AUTH_GOOGLE_CLIENT_SECRET="change_me"
AUTH_GITHUB_CLIENT_ID="change_me"
AUTH_GITHUB_CLIENT_SECRET="change_me"

RESEND_API_KEY="re_change_me"
RESEND_EMAIL_FROM="noreply@yourdomain.com"
# Optional Full access key the deploy check uses to read the sender domain; never uploaded as a Worker secret.
RESEND_MANAGEMENT_API_KEY=

# Drizzle CLI credentials; never uploaded as Worker secrets.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_ACCESS_TOKEN=

SENTRY_AUTH_TOKEN=

STRIPE_SECRET_KEY="sk_test_change_me"
STRIPE_WEBHOOK_SECRET="whsec_change_me"
