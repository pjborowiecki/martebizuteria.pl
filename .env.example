# =============================================================================
# Copy to `.env` (gitignored). Vite loads this for `import.meta.env.VITE_*` in the browser.
#
# Worker bindings, `vars`, and secrets are configured in wrangler.jsonc, the dashboard,
# `wrangler secret put`, and/or `.dev.vars` for local Worker-only values (see Cloudflare docs).
# =============================================================================

# --- Public (browser-safe; VITE_ prefix required) ---
VITE_APP_URL="http://localhost:3000"
VITE_SENTRY_DSN=
VITE_SENTRY_ORG=
VITE_SENTRY_PROJECT=

# --- Private (not read by Vite unless you add a VITE_ name) ---
# AUTH_SECRET=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_DATABASE_ID=
# CLOUDFLARE_ACCESS_TOKEN=
# CLOUDFLARE_EMAIL_SERVICE_URL=
# SENTRY_AUTH_TOKEN=

VITE_R2_URL="https://your-production-cdn-domain.com"
